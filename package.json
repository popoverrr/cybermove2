{
  "name": "cybermove-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/article-covers.mjs && astro build",
    "preview": "astro preview --port 4321",
    "assets": "node scripts/fetch-assets.mjs",
    "photos": "node scripts/fetch-project-photos.mjs",
    "og": "node scripts/og-image.mjs",
    "zip": "node scripts/zip.mjs",
    "qa": "playwright test",
    "linkcheck": "node scripts/linkcheck.mjs",
    "sizes": "node scripts/sizes.mjs",
    "clean": "node scripts/clean.mjs",
    "deploy": "npm run build && node scripts/deploy-ftp.mjs",
    "deploy:dry": "node scripts/deploy-ftp.mjs --dry-run",
    "sites": "node scripts/capture-sites.mjs",
    "covers": "node scripts/article-covers.mjs",
    "covers:sheet": "node scripts/article-covers.mjs --sheet",
    "seo:check": "node scripts/seo-check.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}