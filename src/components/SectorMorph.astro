---
// Interaction #3 (home): sectors list → the brand names of the active sector morph in.
// Sector names are real links to /cases/#<id> (desktop: hover previews, click navigates;
// touch: first tap previews). Every brand name links to its case page /cases/<slug>/.
import { pick, url, href, type Lang } from '../lib/i18n';
import { sectors, cases, casesBySector, monogram } from '../lib/content';
import CasePhoto from './CasePhoto.astro';
interface Props { lang: Lang; label: string; allLabel: string }
const { lang, label, allLabel } = Astro.props;
const first = sectors[0].id;
const sectorHref = (id: string) => url(lang, 'cases', `#${id}`);
---
<div class="sm" data-sector-morph data-autoplay>
  <nav class="sm__list" aria-label={label}>
    <i class="sm__bar" aria-hidden="true"></i>
    {sectors.map((s, i) => (
      <a class:list={['sm__tab', i === 0 && 'is-active']} href={sectorHref(s.id)} data-sector={s.id}
        aria-current={i === 0 ? 'true' : undefined} aria-controls="sm-panel">
        <span class="sm__title">{pick(lang, s.title)}</span>
        <span class="sm__count label num" data-count={casesBySector(s.id).length} data-pad="2">{String(casesBySector(s.id).length).padStart(2, '0')}</span>
      </a>
    ))}
  </nav>
  <div class="sm__panel" id="sm-panel" aria-live="polite">
    <div class="sm__lines">
      {sectors.map((s, i) => <p class:list={['sm__line muted', i === 0 && 'is-on']} data-sector={s.id}>{pick(lang, s.line)}</p>)}
    </div>
    <ul class="sm__names list-reset">
      {cases.map((c) => (
        <li class:list={['sm__name', c.sector !== first && 'is-off']} data-sector={c.sector}>
          <a class="sm__name-link" data-case={c.id} href={href(lang, `cases/${c.id}/`)}>{pick(lang, c.cardName)}</a><span class="sm__sep" aria-hidden="true"> · </span>
        </li>
      ))}
    </ul>
    <!-- photos of the active sector's cases (fixes 4 §3): a horizontal row with snap, links to the cases -->
    <ul class="sm__thumbs list-reset" aria-label={label}>
      {cases.map((c) => (
        <li class:list={['sm__thumb', c.sector !== first && 'is-off']} data-sector={c.sector}>
          <a class="sm__thumb-link" href={href(lang, `cases/${c.id}/`)} data-case={c.id} tabindex="-1">
            <span class="sm__thumb-img"><CasePhoto item={c} lang={lang} sizes="160px" thumb decorative /></span>
            <span class="sm__thumb-cap label">{monogram(pick(lang, c.cardName))}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="label muted sm__pos" aria-hidden="true"><span class="num" data-sm-pos>01</span> / {String(sectors.length).padStart(2, '0')}</p>
    <a class="link link--arrow sm__all" href={sectorHref(first)} data-sector-all>{allLabel} →</a>
  </div>
</div>

<script>
  import { flipSwap } from '../scripts/core/flip';
  import { finePointer } from '../scripts/core/motion';

  document.querySelectorAll<HTMLElement>('[data-sector-morph]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('.sm__tab')];
    const names = [...root.querySelectorAll<HTMLElement>('.sm__name')];
    const lines = [...root.querySelectorAll<HTMLElement>('.sm__line')];
    const all = root.querySelector<HTMLAnchorElement>('[data-sector-all]')!;
    const bar = root.querySelector<HTMLElement>('.sm__bar')!;
    let active = tabs[0].dataset.sector!;
    const pos = root.querySelector<HTMLElement>('[data-sm-pos]');
    const thumbs = [...root.querySelectorAll<HTMLElement>('.sm__thumb')];
    const row = root.querySelector<HTMLElement>('.sm__thumbs')!;
    // old thumbs leave (opacity + 8 px), new ones arrive with a 30 ms cascade
    let swapT = 0;
    const swapThumbs = (id: string) => {
      clearTimeout(swapT);
      thumbs.forEach((t) => { if (!t.classList.contains('is-off')) t.classList.add('is-leaving'); });
      swapT = window.setTimeout(() => {
        let k = 0;
        thumbs.forEach((t) => {
          const on = t.dataset.sector === id;
          t.classList.remove('is-leaving');
          t.classList.toggle('is-off', !on);
          if (on) { t.style.setProperty('--d', `${k++ * 30}ms`); t.classList.remove('is-in'); void t.offsetWidth; t.classList.add('is-in'); }
        });
        row.scrollLeft = 0;
      }, 160);
    };
    // name ↔ thumb highlight
    const pair = (caseId: string, on: boolean, scroll = false) => {
      root.querySelectorAll<HTMLElement>(`[data-case="${caseId}"]`).forEach((el) => el.classList.toggle('is-hot', on));
      if (on && scroll) {
        const t = root.querySelector<HTMLElement>(`.sm__thumb-link[data-case="${caseId}"]`)?.parentElement;
        if (t) row.scrollTo({ left: t.offsetLeft - row.offsetLeft, behavior: 'smooth' });
      }
    };
    root.querySelectorAll<HTMLElement>('.sm__name-link, .sm__thumb-link').forEach((a) => {
      const id = a.dataset.case!, isName = a.classList.contains('sm__name-link');
      a.addEventListener('pointerenter', () => pair(id, true, isName));
      a.addEventListener('pointerleave', () => pair(id, false));
      a.addEventListener('focus', () => pair(id, true, isName));
      a.addEventListener('blur', () => pair(id, false));
    });
    let interacted = false;

    const markLast = () => {
      const vis = names.filter((n) => !n.classList.contains('is-off'));
      names.forEach((n) => n.classList.toggle('is-last', n === vis[vis.length - 1]));
    };
    const moveBar = (tab: HTMLElement) => {
      bar.style.transform = `translateY(${tab.offsetTop}px)`;
      bar.style.height = `${tab.offsetHeight}px`;
    };

    function select(id: string) {
      if (id === active) return;
      active = id;
      tabs.forEach((t) => {
        const on = t.dataset.sector === id;
        t.classList.toggle('is-active', on);
        if (on) { t.setAttribute('aria-current', 'true'); moveBar(t); } else t.removeAttribute('aria-current');
      });
      all.setAttribute('href', tabs.find((t) => t.dataset.sector === id)!.getAttribute('href')!);
      lines.forEach((l) => l.classList.toggle('is-on', l.dataset.sector === id));
      if (pos) pos.textContent = String(tabs.findIndex((x) => x.dataset.sector === id) + 1).padStart(2, '0');
      flipSwap(names, (el) => el.dataset.sector === id).then(markLast);
      swapThumbs(id);
      markLast();
      // keep the active chip visible in the horizontal chip row (mobile) without scrolling the page
      const t = tabs.find((x) => x.dataset.sector === id);
      const list = t?.parentElement;
      if (t && list && list.scrollWidth > list.clientWidth) list.scrollTo({ left: t.offsetLeft - 16, behavior: 'smooth' });
    }

    const stop = () => { interacted = true; };
    let intent = 0;
    tabs.forEach((t) => {
      t.addEventListener('click', (e) => {
        stop();
        // touch: the first tap only previews the sector; the "All projects" link navigates
        if (!finePointer()) { e.preventDefault(); select(t.dataset.sector!); }
        // desktop: the link navigates to /cases/#<id>
      });
      t.addEventListener('focus', () => { if (t.matches(':focus-visible')) { stop(); select(t.dataset.sector!); } });
      if (finePointer()) {
        t.addEventListener('pointerenter', () => {
          clearTimeout(intent);
          intent = window.setTimeout(() => { stop(); select(t.dataset.sector!); }, 120);
        });
        t.addEventListener('pointerleave', () => clearTimeout(intent));
      }
    });
    root.querySelectorAll('.sm__name-link, [data-sector-all]').forEach((a) => a.addEventListener('click', stop));

    // Autoplay while in view until the first interaction.
    let hover = false, inView = false, timer = 0;
    root.addEventListener('pointerenter', () => (hover = true));
    root.addEventListener('pointerleave', () => (hover = false));
    root.addEventListener('pointerdown', stop);
    const tick = () => {
      if (interacted) return;
      if (inView && !hover && !root.contains(document.activeElement) && !document.hidden) {
        const i = tabs.findIndex((t) => t.dataset.sector === active);
        select(tabs[(i + 1) % tabs.length].dataset.sector!);
      }
      timer = window.setTimeout(tick, 3500);
    };
    if (root.hasAttribute('data-autoplay')) {
      new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        clearTimeout(timer);
        if (inView && !interacted) timer = window.setTimeout(tick, 3500);
      }, { threshold: 0.35 }).observe(root);
    }

    // horizontal swipe over the sector area switches to the next / previous sector (vertical scroll untouched)
    let sx = 0, sy = 0, tracking = false;
    const panel = root.querySelector<HTMLElement>('.sm__names')!;
    panel.addEventListener('touchstart', (e) => { const t = e.touches[0]; sx = t.clientX; sy = t.clientY; tracking = true; }, { passive: true });
    panel.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
      if (Math.abs(dx) < 30 || Math.abs(dx) <= Math.abs(dy)) return;
      stop();
      const i = tabs.findIndex((x) => x.dataset.sector === active);
      const n = (i + (dx < 0 ? 1 : -1) + tabs.length) % tabs.length;
      select(tabs[n].dataset.sector!);
    }, { passive: true });

    markLast();
    requestAnimationFrame(() => moveBar(tabs[0]));
    window.addEventListener('resize', () => moveBar(tabs.find((t) => t.dataset.sector === active)!));
  });
</script>
