---
import { t, url, href, pick, otherLang, type Lang } from '../lib/i18n';
import { directions, contacts, company } from '../lib/content';
import BendText from './BendText.astro';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const other = otherLang(lang);
const year = new Date().getFullYear();
const sectionLinks = (['services', 'cases', 'insights', 'about', 'contact'] as const).map((k) => ({ href: url(lang, k), text: t(lang, `nav.${k}`) }));
---
<footer class="ftr" data-theme="dark" data-label="CYBER MOVE CONSULTING">
  <BendText lang={lang} />
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <a href={url(lang, 'home')} class="ftr__wm" aria-label="Cyber Move Consulting"><Wordmark /></a>
      <p class="muted ftr__tagline">{t(lang, 'footer.tagline')}</p>
    </div>
    <nav class="ftr__col" aria-labelledby="ftr-services">
      <h2 class="label muted" id="ftr-services">{t(lang, 'nav.services')}</h2>
      <ul class="list-reset">
        {directions.map((d) => <li><a class="link" href={href(lang, `services/${d.id}/`)}>{pick(lang, d.nameFull)}</a></li>)}
      </ul>
    </nav>
    <nav class="ftr__col" aria-labelledby="ftr-company">
      <h2 class="label muted" id="ftr-company">{t(lang, 'footer.sectionsTitle')}</h2>
      <ul class="list-reset">
        {sectionLinks.map((l) => <li><a class="link" href={l.href}>{l.text}</a></li>)}
      </ul>
    </nav>
    <div class="ftr__col">
      <h2 class="label muted">{t(lang, 'nav.contact')}</h2>
      <ul class="list-reset">
        <li><a class="link ftr__wa" href={contacts.whatsapp.url} target="_blank" rel="noopener" data-magnetic><Icon name="whatsapp" size={16} /><span>WhatsApp · {contacts.whatsapp.display}</span></a></li>
        <li><a class="link label" href={contacts.whatsapp.url} target="_blank" rel="noopener">{t(lang, 'nav.partner')} · {contacts.whatsapp.display}</a></li>
        {contacts.phone && <li><a class="link" href={`tel:${contacts.phone.number}`}>{t(lang, 'contact.channels.phoneLabel')} · {contacts.phone.display}</a></li>}
        {contacts.email && <li><a class="link" href={`mailto:${contacts.email}`}>{contacts.email}</a></li>}
        <li><span class="label muted">{t(lang, 'footer.langTitle')}</span> <a class="link label" href={altHref} hreflang={other} lang={other} data-lang-switch>{t(lang, 'nav.lang')} · {t(lang, 'nav.langLabel')}</a></li>
      </ul>
      <p class="label muted ftr__geo"><span>{t(lang, 'footer.geoTitle')}</span><br />{t(lang, 'footer.cities')}</p>
    </div>
  </div>
  <div class="container ftr__bottom label muted">
    <span>© {year} {company.legalName}</span>
    <a class="link" href={url(lang, 'privacy')}>{t(lang, 'footer.privacy')}</a>
    <a class="link ftr__top" href="#top"><span>{t(lang, 'common.backToTop')}</span><Icon name="arrow-up" size={12} /></a>
  </div>
</footer>
