---
import { t, ta, url, asset, pick, type Lang } from '../lib/i18n';
import { contacts, services } from '../lib/content';
import Icon from './Icon.astro';
// idp: id prefix (the form exists twice on /contact/: page + contact panel); compact: panel version
// without «company» and «format» (docs/14-rework.md §11)
interface Props { lang: Lang; idp?: string; compact?: boolean }
const { lang, idp = 'cf', compact = false } = Astro.props;
const f = (k: string) => t(lang, `contact.form.${k}`);
const formats = ta<{ id: string; label: string }[]>(lang, 'contact.form.formats');
// services without own pages (rework §8, rows 08–10): only in the form
const extra = ta<{ id: string; label: string }[]>(lang, 'homeServices.extra');
const emailMode = !!contacts.formEmail;
// WhatsApp message: intro line + "Label: value" lines (labels are the form's own labels)
const template = [f('waTemplate'), `${f('name')}: {name}`, `${f('contact')}: {contact}`, `${f('company')}: {company}`,
  `${f('service')}: {service}`, `${f('format')}: {format}`, `${f('message')}: {message}`].join('\n');
---
<form class="cform" action={contacts.whatsapp.url} method="get" target="_blank" novalidate data-contact-form
  data-wa={contacts.whatsapp.url} data-endpoint={asset('api/send.php')} data-email={emailMode ? '1' : undefined}
  data-template={template}
  data-msg-required={f('required')} data-msg-contact={f('invalidContact')}
  data-msg-success={f('success')} data-msg-error={f('error')}>
  <div class="field">
    <input class="field__input" id={`${idp}-name`} name="name" type="text" autocomplete="name" placeholder=" " required maxlength="120" aria-describedby={`${idp}-name-err`} />
    <label class="field__label" for={`${idp}-name`}>{f('name')}</label>
    <p class="field__err small" id={`${idp}-name-err`} aria-live="polite"></p>
  </div>
  <div class="field">
    <input class="field__input" id={`${idp}-contact`} name="contact" type="text" autocomplete="tel" inputmode="tel" placeholder=" " required maxlength="160" aria-describedby={`${idp}-contact-err`} />
    <label class="field__label" for={`${idp}-contact`}>{f('contact')}</label>
    <p class="field__err small" id={`${idp}-contact-err`} aria-live="polite"></p>
  </div>
  {!compact && <div class="field">
    <input class="field__input" id={`${idp}-company`} name="company" type="text" autocomplete="organization" placeholder=" " maxlength="160" />
    <label class="field__label" for={`${idp}-company`}>{f('company')}</label>
  </div>}
  <div class="field field--select">
    <select class="field__input" id={`${idp}-service`} name="service">
      <option value="" data-label="">{f('serviceNone')}</option>
      {services.map((s) => <option value={s.id} data-label={pick(lang, s.name)}>{pick(lang, s.name)}</option>)}
      {extra.map((x) => <option value={x.id} data-label={x.label}>{x.label}</option>)}
    </select>
    <label class="field__label is-up" for={`${idp}-service`}>{f('service')}</label>
  </div>

  {!compact && <fieldset class="chips">
    <legend class="label muted">{f('format')}</legend>
    <div class="chips__list">
      {formats.map((n) => (
        <label class="chip chip--check">
          <input type="radio" name="format" value={n.id} data-label={n.label} />
          <span>{n.label}</span>
        </label>
      ))}
    </div>
  </fieldset>}

  <div class="field field--area">
    <textarea class="field__input" id={`${idp}-message`} name="message" rows="4" placeholder=" " maxlength="2000"></textarea>
    <label class="field__label" for={`${idp}-message`}>{f('message')}</label>
  </div>

  <div class="cform__hp" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="cform__foot">
    <div class="btn-row">
      <button class="btn btn--primary cform__submit" type="submit" data-magnetic>
        <span class="btn__in">
          <span class="btn__text">{f('submit')}</span>
          <Icon name="arrow" class="btn__arrow" />
        </span>
        <span class="cform__spinner" aria-hidden="true"></span>
      </button>
      {!compact && <a class="btn btn--secondary" href={contacts.whatsapp.url} target="_blank" rel="noopener">
        <span class="btn__in"><Icon name="whatsapp" size={18} class="btn__lead-icon" /><span class="btn__text">{f('whatsapp')}</span></span>
      </a>}
    </div>
    <p class="small muted cform__consent"><a class="link" href={url(lang, 'privacy')}>{f('consent')}</a>.</p>
    <p class="cform__status" role="status" aria-live="polite" hidden data-sending={f('sending')}></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const d = form.dataset;
    const loaded = Date.now();
    const $ = <T extends Element>(s: string) => form.querySelector<T>(s)!;
    const status = $<HTMLElement>('.cform__status');
    const submit = $<HTMLButtonElement>('.cform__submit');

    // Prefill from the query: ?service=<slug> selects the service.
    const svc = new URLSearchParams(location.search).get('service');
    const select = $<HTMLSelectElement>('select[name="service"]');
    if (svc && [...select.options].some((o) => o.value === svc)) select.value = svc;

    // chip press micro-interaction
    form.querySelectorAll<HTMLElement>('.chip--check').forEach((c) => {
      c.addEventListener('pointerdown', () => c.classList.add('is-press'));
      ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => c.addEventListener(ev, () => c.classList.remove('is-press')));
    });

    const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
    const setErr = (n: string, msg: string) => {
      const input = form.elements.namedItem(n) as HTMLInputElement;
      const err = form.querySelector<HTMLElement>(`[id$="-${n}-err"]`);
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      input.closest('.field')?.classList.toggle('is-invalid', !!msg);
      if (err) err.textContent = msg;
    };
    const contactOk = (v: string) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) || // email
      /^@?[a-zA-Z0-9_]{4,32}$/.test(v) || // telegram handle
      /^\+?[\d\s()-]{7,20}$/.test(v); // phone / WhatsApp

    function validate() {
      let ok = true;
      const name = val('name'), contact = val('contact');
      setErr('name', name ? '' : d.msgRequired!);
      if (!name) ok = false;
      if (!contact) { setErr('contact', d.msgRequired!); ok = false; }
      else if (!contactOk(contact)) { setErr('contact', d.msgContact!); ok = false; }
      else setErr('contact', '');
      return ok;
    }
    ['name', 'contact'].forEach((n) => form.elements.namedItem(n)?.addEventListener('blur', () => {
      if (form.classList.contains('was-validated')) validate();
    }));

    function message() {
      const format = form.querySelector<HTMLInputElement>('input[name="format"]:checked')?.dataset.label ?? '';
      const service = select.selectedOptions[0]?.dataset.label ?? '';
      const values: Record<string, string> = { name: val('name'), company: val('company'), contact: val('contact'), service, format, message: val('message') };
      // Lines whose value is empty are dropped, so the message stays clean.
      return (d.template || '')
        .split('\n')
        .filter((line) => { const m = line.match(/\{(\w+)\}/); return !m || values[m[1]]; })
        .map((line) => line.replace(/\{(\w+)\}/g, (_, k) => values[k] ?? ''))
        .join('\n');
    }

    function done(text: string, ok = true) {
      status.hidden = false;
      status.textContent = text;
      status.classList.toggle('is-error', !ok);
      submit.classList.remove('is-busy');
      submit.disabled = false;
    }
    const openWhatsApp = (text: string) => {
      const u = `${d.wa}?text=${encodeURIComponent(text)}`;
      window.open(u, '_blank', 'noopener');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.classList.add('was-validated');
      if (!validate()) {
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      if (val('website')) return; // honeypot
      const text = message();
      submit.classList.add('is-busy');
      submit.disabled = true;
      status.hidden = false; status.classList.remove('is-error'); status.textContent = status.dataset.sending || '';
      if (d.email) {
        try {
          const res = await fetch(d.endpoint!, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: val('name'), company: val('company'), contact: val('contact'), service: select.value, format: form.querySelector<HTMLInputElement>('input[name="format"]:checked')?.value ?? '', message: val('message'), website: val('website'), ts: loaded, lang: document.documentElement.lang }),
          });
          const json = await res.json().catch(() => ({ ok: false }));
          if (res.ok && json.ok) { done(d.msgSuccess!); form.reset(); return; }
          throw new Error('send failed');
        } catch {
          // Never lose a lead: fall back to WhatsApp.
          openWhatsApp(text);
          done(d.msgError!, false);
          return;
        }
      }
      openWhatsApp(text);
      setTimeout(() => done(d.msgSuccess!), 500);
    });
  });
</script>
