---
// «Услуги»: a horizontal ribbon of 10 service cards, each with its own looped motion (docs: REPORT.md § Услуги-
// ролики). Native horizontal scroll with snap (+ arrows and mouse drag on desktop, scripts/case-row.ts manual mode).
// Card → the service page (01–07 existing pages, 08–10 /services/<id>/).
import Icon from './Icon.astro';
import ServiceMotion from './ServiceMotion.astro';
import { t, type Lang } from '../lib/i18n';
import { motionServices } from '../lib/motion';
interface Props { lang: Lang; heading?: 'h1' | 'h2' }
const { lang, heading = 'h2' } = Astro.props;
const H = heading;
const list = motionServices(lang);
---
<H class="srib-title reveal">{t(lang, 'homeServices.title')}<span class="srib-title__px" aria-hidden="true"></span><span class="srib-title__n label" aria-hidden="true" data-n={String(list.length).padStart(2, '0')}></span></H>
<div class="crow srib reveal" data-crow="manual" style="--rd:80ms">
  <div class="crow__viewport">
    <ul class="crow__track list-reset" aria-label={t(lang, 'homeServices.title')}>
      {list.map((m) => (
        <li class="mcard">
          <a class="mcard__link" href={m.link} data-theme="dark">
            <span class="mcard__media"><ServiceMotion id={m.id} variant="card" /></span>
            <span class="mcard__meta">
              <span class="mcard__idx label">{m.index} / {String(list.length).padStart(2, '0')}</span>
              <span class="mcard__name">{m.label}</span>
              <span class="mcard__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="crow__nav" aria-hidden="true">
    <button type="button" class="crow__btn" data-crow-prev tabindex="-1" aria-label={t(lang, 'casesBlock.prev')}><Icon name="arrow" size={16} class="crow__prev-icon" /></button>
    <button type="button" class="crow__btn" data-crow-next tabindex="-1" aria-label={t(lang, 'casesBlock.next')}><Icon name="arrow" size={16} /></button>
  </div>
</div>
<script>
  import '../scripts/case-row';
</script>
