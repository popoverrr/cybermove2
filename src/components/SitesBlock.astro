---
// Compact «Websites we have built» block (home, the «Websites» service page): 2×2 windows on desktop.
import Block from './Block.astro';
import BlockHead from './BlockHead.astro';
import SiteShowcase from './SiteShowcase.astro';
import { t, url, type Lang } from '../lib/i18n';
import { sites } from '../lib/content';
interface Props { lang: Lang; theme: 'dark' | 'light'; lead?: boolean }
const { lang, theme, lead = true } = Astro.props;
---
<Block theme={theme} label={t(lang, 'sites.blockTitle')} class="sites-block">
  <div class="container">
    <BlockHead label={t(lang, 'sites.label')} link={{ href: url(lang, 'sites'), text: t(lang, 'sites.all').replace(/\s*→$/, '') }} />
    <h2 class="section-title reveal" data-split>{t(lang, 'sites.blockTitle')}</h2>
    {lead && <p class="lead muted section-lead-after reveal">{t(lang, 'sites.lead')}</p>}
    <div class="sites-grid">
      {sites.map((s, i) => <SiteShowcase site={s} index={i} lang={lang} compact />)}
    </div>
    <p class="sites__more reveal"><a class="link link--arrow" href={url(lang, 'sites')}><span>{t(lang, 'sites.all').replace(/\s*→$/, '')}</span> →</a></p>
  </div>
</Block>
