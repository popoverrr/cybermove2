---
// Hero of a service-area / service page: breadcrumbs, H1 (key phrase as a kicker + thesis), lead, mono metrics,
// a hairline grid and the area's large index as decor (no photos, docs/11-fixes-2.md §C) and, where the page has one,
// the service motion loop (lib/motion.ts).
import Block from './Block.astro';
import Crumbs from './Crumbs.astro';
import type { Crumb } from '../layouts/Base.astro';
import type { Lang } from '../lib/i18n';
import ServiceMotion from './ServiceMotion.astro';
import type { MotionId } from '../lib/motion';
interface Props { lang: Lang; label: string; crumbs: Crumb[]; kicker?: string; title: string; lead: string; metrics?: string; index?: string; sub?: string; motion?: MotionId }
const { lang, label, crumbs, kicker, title, lead, metrics, index, sub, motion } = Astro.props;
---
<Block theme="dark" label={label} first hero class="page-hero dir-hero">
  <div class="dir-hero__grid" aria-hidden="true"></div>
  {index && <span class="dir-hero__index" aria-hidden="true">{index}</span>}
  <div class="container">
    <Crumbs lang={lang} items={crumbs} />
    <h1 class="hero__title reveal">
      {kicker && <span class="label hero__label hero__kicker">{kicker}</span>}{kicker && ' '}
      <span class="hero__thesis" data-split>{title}</span>
    </h1>
    {sub && <p class="dir-hero__sub reveal" style="--rd:80ms">{sub}</p>}
    {lead && <p class="lead hero__lead reveal" style="--rd:120ms">{lead}</p>}
    {metrics && <p class="label hero__codes reveal" style="--rd:180ms">{metrics}</p>}
    <slot />
    {motion && <div class="dir-hero__motion reveal" style="--rd:220ms"><ServiceMotion id={motion} variant="hero" eager /></div>}
  </div>
</Block>
