---
// Category chips. mode="filter" (home): «All» + 8 industries + «Websites», wrapping rows, filters the ribbon.
// mode="nav" (/cases/, docs/15-stabilize.md §2): the multi-line chips stay in place (anchors); a separate one-line
// bar appears under the header once they scroll away — full labels, scrollable, exactly one active chip (the
// section whose heading last passed under the bar), the active chip glides into view inside the bar.
import { t, url, type Lang } from '../lib/i18n';
import { sectors } from '../lib/content';
interface Props { lang: Lang; mode: 'filter' | 'nav'; target?: string }
const { lang, mode, target } = Astro.props;
const chip = (id: string) => (id === 'sites' ? t(lang, 'casesBlock.sites') : t(lang, `casesBlock.chips.${id}`));
const ids = [...sectors.map((s) => s.id), 'sites'];
---
{mode === 'filter' ? (
  <div class="gchips" role="group" aria-label={t(lang, 'casesBlock.title')} data-gchips="filter" data-target={target}>
    <button type="button" class="gchip is-on" aria-pressed="true" data-sector="all"><span>{t(lang, 'casesBlock.all')}</span></button>
    {ids.map((id) => <button type="button" class="gchip" aria-pressed="false" data-sector={id}><span>{chip(id)}</span></button>)}
  </div>
) : (
  <>
    <nav class="gchips gchips--nav" aria-label={t(lang, 'casesBlock.title')} data-gchips="nav">
      {ids.map((id) => <a class="gchip" href={url(lang, 'cases', `#${id}`)} data-sector={id}><span>{chip(id)}</span></a>)}
    </nav>
    <div class="cbar" data-cbar aria-hidden="true">
      <div class="cbar__row">
        {ids.map((id) => <a class="gchip" href={url(lang, 'cases', `#${id}`)} data-sector={id} tabindex="-1"><span>{chip(id)}</span></a>)}
      </div>
    </div>
  </>
)}
<script>
  import '../scripts/case-filter';
</script>
