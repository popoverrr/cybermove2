---
// A website as a case card (rework §6.2): the skeleton's window as a browser — domain in the bar, the long
// screenshot inside slowly scrolls down and back while the card is on screen (owner's request; transform only,
// paused off-screen and with reduced motion). Name, type, one line of summary. External link, new tab.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, pick, type Lang } from '../lib/i18n';
import type { Site } from '../lib/content';
interface Props { site: Site; lang: Lang; as?: 'li' | 'div' }
const { site, lang, as: Tag = 'li' } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/sites/*-desktop.webp', { eager: true });
const img = shots[`/src/assets/sites/${site.id}-desktop.webp`]?.default;
---
<Tag class="pcard pcard--site" data-sector="sites" data-id={site.id}>
  <a class="pcard__link" href={site.url} target="_blank" rel="noopener" data-cursor={t(lang, 'sites.openShort').replace(/\s*↗$/, '')}>
    <div class="pcard__cover pcard__cover--win">
      <span class="win__bar pcard__winbar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__path label">{site.domain}</span><span></span></span>
      <span class="pcard__shotwrap" data-site-shot>
        {img && <Image src={img} alt={t(lang, 'sites.alt', { domain: site.domain })} widths={[480, 720]} sizes="(min-width: 1024px) 340px, 72vw" loading="lazy" decoding="async" class="pcard__shot" />}
      </span>
    </div>
    <div class="pcard__body">
      <p class="label muted">{pick(lang, site.type)}</p>
      <h3 class="pcard__name h3">{site.name} <span aria-hidden="true">↗</span></h3>
      <p class="pcard__short muted small">{pick(lang, site.summary)}</p>
    </div>
  </a>
</Tag>
<script>
  import '../scripts/site-shots';
</script>
