---
// Interaction #1: five windows with live-looking miniatures of each section (real HTML/CSS, no screenshots).
import { t, ta, url, pick, type Lang } from '../lib/i18n';
import { directions, cases, sectors, insights, contacts, monogram } from '../lib/content';
import CasePhoto from './CasePhoto.astro';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
// 12 different cases, picked round-robin across sectors so the miniature shows the range
const bySector = sectors.map((s) => cases.filter((c) => c.sector === s.id));
const featured: typeof cases = [];
for (let i = 0; featured.length < 12 && i < 12; i++) for (const list of bySector) if (list[i] && featured.length < 12) featured.push(list[i]);
const channels = [
  { label: t(lang, 'contact.channels.whatsapp'), value: contacts.whatsapp.display },
  ...(contacts.phone ? [{ label: t(lang, 'contact.channels.phoneLabel'), value: contacts.phone.display }] : []),
];
const steps = ta<{ title: string; stage: string }[]>(lang, 'method.steps');
const path = (k: string) => t(lang, `home.windows.${k}.path`);
const W = {
  cases: { title: t(lang, 'nav.cases'), caption: t(lang, 'cases.hero.title') },
  services: { title: t(lang, 'nav.services'), caption: t(lang, 'services.hero.label') },
  insights: { title: t(lang, 'nav.insights'), caption: t(lang, 'insights.hero.title') },
  about: { title: t(lang, 'nav.about'), caption: t(lang, 'common.codes') },
  contact: { title: t(lang, 'nav.contact'), caption: `WhatsApp · ${contacts.whatsapp.display}` },
};
---
<ul class="hwins list-reset" role="list">
  <li class="hwins__cell hwins__cell--projects reveal" style="--rd:0ms">
    <a class="win hwin" href={url(lang, 'cases')} data-win="cases" data-cursor data-magnetic>
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__path label">{path('cases')}</span><span></span></div>
      <div class="hwin__mini hwin__mini--projects" aria-hidden="true">
        <div class="hwin__covers">
          {[0, 1, 2].map((set) => (
            <div class="hwin__covers-set" aria-hidden={set > 0 ? 'true' : undefined}>
              {featured.map((c) => (
                <div class="hwin__cover">
                  <CasePhoto item={c} lang={lang} sizes="240px" thumb decorative />
                  <span class="hwin__mono">{monogram(pick(lang, c.cardName))}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="hwin__foot"><span class="hwin__title h3">{W.cases.title}</span><span class="hwin__cap muted small">{W.cases.caption}</span><Icon name="arrow" class="hwin__arrow" /></div>
    </a>
  </li>

  <li class="hwins__cell hwins__cell--services reveal" style="--rd:80ms">
    <a class="win hwin" href={url(lang, 'services')} data-win="services" data-cursor data-magnetic>
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__path label">{path('services')}</span><span></span></div>
      <div class="hwin__mini hwin__mini--services" aria-hidden="true">
        <ol class="list-reset">{directions.map((d) => <li><span class="muted">{d.index}</span> {pick(lang, d.nameFull)}</li>)}</ol>
      </div>
      <div class="hwin__foot"><span class="hwin__title h3">{W.services.title}</span><span class="hwin__cap muted small">{W.services.caption}</span><Icon name="arrow" class="hwin__arrow" /></div>
    </a>
  </li>

  <li class="hwins__cell hwins__cell--team reveal" style="--rd:160ms">
    <a class="win hwin" href={url(lang, 'insights')} data-win="insights" data-cursor data-magnetic>
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__path label">{path('insights')}</span><span></span></div>
      <div class="hwin__mini hwin__mini--services hwin__mini--insights" aria-hidden="true">
        <ol class="list-reset">{insights.slice(0, 5).map((a) => <li><span class="muted">{pick(lang, directions.find((d) => d.id === a.direction)!.name)}</span> {pick(lang, a.title)}</li>)}</ol>
      </div>
      <div class="hwin__foot"><span class="hwin__title h3">{W.insights.title}</span><span class="hwin__cap muted small">{W.insights.caption}</span><Icon name="arrow" class="hwin__arrow" /></div>
    </a>
  </li>

  <li class="hwins__cell hwins__cell--about reveal" style="--rd:240ms">
    <a class="win hwin" href={url(lang, 'about')} data-win="about" data-cursor data-magnetic>
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__path label">{path('about')}</span><span></span></div>
      <div class="hwin__mini hwin__mini--about" aria-hidden="true">
        <ol class="list-reset">
          {steps.map((s, i) => <li style={`--i:${i}`}><span class="label muted">{s.stage}</span><span class="hwin__step">{s.title}</span></li>)}
        </ol>
      </div>
      <div class="hwin__foot"><span class="hwin__title h3">{W.about.title}</span><span class="hwin__cap muted small">{W.about.caption}</span><Icon name="arrow" class="hwin__arrow" /></div>
    </a>
  </li>

  <li class="hwins__cell hwins__cell--contact reveal" style="--rd:320ms">
    <a class="win hwin" href={url(lang, 'contact')} data-win="contact" data-cursor data-magnetic>
      <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__path label">{path('contact')}</span><span></span></div>
      <div class="hwin__mini hwin__mini--contact" aria-hidden="true">
        <dl class="hwin__channels">
          {channels.map((c, i) => (
            <div class="hwin__channel">
              <dt class="label muted">{c.label}</dt>
              <dd class="hwin__num">{c.value}{i === channels.length - 1 && <i class="hwin__caret"></i>}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="hwin__foot"><span class="hwin__title h3">{W.contact.title}</span><span class="hwin__cap muted small">{W.contact.caption}</span><Icon name="arrow" class="hwin__arrow" /></div>
    </a>
  </li>
</ul>
