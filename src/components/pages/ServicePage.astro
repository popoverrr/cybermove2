---
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import BlockHead from '../BlockHead.astro';
import Button from '../Button.astro';
import DirHero from '../DirHero.astro';
import CaseCard from '../CaseCard.astro';
import ArticleRows from '../ArticleRows.astro';
import FaqList from '../FaqList.astro';
import SiteCta from '../SiteCta.astro';
import SitesBlock from '../SitesBlock.astro';
import { t, href, url, pick, type Lang } from '../../lib/i18n';
import { directionById, servicesOf, caseById, insightById, type Service } from '../../lib/content';

interface Props { lang: Lang; s: Service }
const { lang, s } = Astro.props;
const L = (k: string) => t(lang, `service.${k}`);
const d = directionById(s.direction);
const seo = pick(lang, s.seo);
const route = `services/${d.id}/${s.id}/`;
const crumbs = [{ name: t(lang, 'nav.services'), route: 'services/' }, { name: pick(lang, d.name), route: `services/${d.id}/` }, { name: pick(lang, s.name), route }];
const steps = pick(lang, s.steps);
const faq = pick(lang, s.faq);
const others = servicesOf(d).filter((x) => x.id !== s.id);
const site = Astro.site!.origin;
const contactQ = `?service=${s.id}`;
const codes = t(lang, 'common.codes').replace(/ · /g, ' → ');
const hasInsights = s.insights.length > 0;
---
<Base lang={lang} page="services" route={route} path={`${t(lang, 'home.windows.services.path')} / ${d.id} / ${s.id}`} title={seo.title} description={seo.description} crumbs={crumbs}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'Service', name: pick(lang, s.title), alternateName: [pick(lang, s.seoTitle), seo.h1].filter((x, i, a) => a.indexOf(x) === i && x !== pick(lang, s.title)), description: seo.description, url: site + href(lang, route),
      serviceType: pick(lang, s.name), category: pick(lang, d.nameFull), provider: { '@id': site + href('ru') + '#organization' } },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ]}>
  <DirHero lang={lang} label={`${d.index} · ${s.index}`} crumbs={crumbs} title={pick(lang, s.title)} lead={pick(lang, s.lead)} metrics={d.metrics} index={d.index} />

  <Block theme="light" label={L('includes')} class="svc-page-intro">
    <div class="container">
      {pick(lang, s.intro).map((p) => <p class="lead reveal svc-page__intro">{p}</p>)}
      <BlockHead label="01" />
      <h2 class="section-title reveal" data-split>{L('includes')}</h2>
      <ol class="cells list-reset">
        {pick(lang, s.includes).map((c, i) => (
          <li class="cells__cell reveal" style={`--rd:${(i % 4) * 50}ms`}>
            <span class="label muted num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="cells__title">{c.t}</h3>
            <p class="small muted">{c.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  <Block theme="dark" label={L('how')} class="home-method svc-how">
    <div class="container">
      <BlockHead label={`02 · ${codes}`} />
      <div class="method" data-method>
        <div class="method__aside">
          <h2 class="reveal" data-split>{L('how')}</h2>
          <div class="method__counter label" aria-hidden="true">
            <span class="method__now num">01</span><span class="muted"> / {String(steps.length).padStart(2, '0')}</span>
            <span class="method__track"><i class="method__fill"></i></span>
          </div>
          {pick(lang, s.stepsNote) && <p class="small muted method__note">{pick(lang, s.stepsNote)}</p>}
        </div>
        <ol class="method__steps list-reset">
          {steps.map((st, i) => (
            <li class:list={['method__step reveal', i === 0 && 'is-active']} data-step={i}>
              <span class="label muted">{String(i + 1).padStart(2, '0')} · {st.stage}</span>
              <h3 class="method__title method__title--sm">{st.t}</h3>
              <p class="lead method__text">{st.d}</p>
              {st.time && <p class="label method__time"><span class="muted">{pick(lang, s.timeLabel)}:</span> {st.time}</p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Block>

  <Block theme="light" label={L('result')} class="svc-result">
    <div class="container">
      <BlockHead label="03" />
      <div class="split">
        <div class="split__a"><h2 class="reveal" data-split>{L('result')}</h2></div>
        <div class="split__b">
          <ol class="numrows list-reset">
            {pick(lang, s.result).map((r, i) => (
              <li class="numrows__row reveal" style={`--rd:${i * 60}ms`}><span class="label muted num">{String(i + 1).padStart(2, '0')}</span><span class="numrows__text numrows__text--sm">{r}</span></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </Block>

  <Block theme="dark" label={L('forWhom')} class="svc-for">
    <div class="container">
      <BlockHead label="04" />
      <h2 class="section-title reveal" data-split>{L('forWhom')}</h2>
      <ol class="cells cells--2 list-reset">
        {pick(lang, s.forWhom).map((c, i) => (
          <li class="cells__cell reveal" style={`--rd:${i * 50}ms`}>
            <span class="label muted num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="cells__title">{c.t}</h3>
            <p class="muted">{c.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  {s.id === 'websites' && <SitesBlock lang={lang} theme="light" lead={false} />}

  <Block theme="light" label={L('cases')} class="svc-cases">
    <div class="container">
      <BlockHead label="05" link={{ href: href(lang, 'cases/'), text: t(lang, 'home.results.link') }} />
      <h2 class="section-title reveal" data-split>{L('cases')}</h2>
      <ul class="pgrid list-reset">{s.cases.map((id, i) => <CaseCard item={caseById(id)} lang={lang} index={i + 1} />)}</ul>
    </div>
  </Block>

  <Block theme="dark" label={L('faq')} class="svc-faq">
    <div class="container">
      <BlockHead label="06 · FAQ" />
      <div class="faq-layout">
        <h2 class="reveal" data-split>{L('faq')}</h2>
        <FaqList items={faq} />
      </div>
    </div>
  </Block>

  {hasInsights && (
    <Block theme="light" label={L('insights')} class="svc-insights">
      <div class="container">
        <BlockHead label="07" link={{ href: href(lang, `insights/${d.id}/`), text: t(lang, 'insights.allInsights') }} />
        <h2 class="section-title reveal" data-split>{L('insights')}</h2>
        <ArticleRows lang={lang} items={s.insights.map(insightById)} />
      </div>
    </Block>
  )}

  <Block theme={hasInsights ? 'dark' : 'light'} label={L('others')} class="svc-others">
    <div class="container">
      <BlockHead label={`${d.index} · ${pick(lang, d.name)}`} />
      <h2 class="section-title reveal" data-split>{L('others')}</h2>
      <ol class="numrows list-reset">
        {others.map((o, i) => (
          <li class="numrows__row reveal" style={`--rd:${i * 50}ms`}>
            <span class="label muted num">{o.index}</span>
            <a class="numrows__link" href={href(lang, `services/${d.id}/${o.id}/`)}>
              <span class="numrows__text">{pick(lang, o.name)}</span>
              <span class="numrows__sub muted small">{pick(lang, o.line)}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="btn-row reveal svc-others__cta">
        <Button href={url(lang, 'contact', contactQ)}>{L('discuss')}</Button>
        <Button href={href(lang, `services/${d.id}/`)} variant="secondary">{pick(lang, d.nameFull)}</Button>
      </div>
    </div>
  </Block>

  <SiteCta lang={lang} query={contactQ} theme={hasInsights ? 'light' : 'dark'} />
</Base>

<script>
  import '../../scripts/method';
</script>
