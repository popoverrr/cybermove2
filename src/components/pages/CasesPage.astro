---
// /cases/: 8 sections by industry in the order of the live site (docs/11-fixes-2.md §B).
// The chips are navigation to the sections (anchors #<sector id>); /cases/?sector=<id> scrolls to the section.
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import CaseCard from '../CaseCard.astro';
import SiteCta from '../SiteCta.astro';
import { t, ta, pick, type Lang } from '../../lib/i18n';
import { cases, sectors, casesBySector } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = (k: string) => t(lang, `cases.${k}`);
const path = t(lang, 'home.windows.cases.path');
const site = Astro.site!.origin;
const forms = ta<string[]>(lang, 'cases.forms');
// «1 кейс / 3 кейса / 7 кейсов», «1 case / 3 cases»
const plural = (n: number) => {
  if (lang !== 'ru') return n === 1 ? forms[0] : forms[1];
  const m10 = n % 10, m100 = n % 100;
  return m10 === 1 && m100 !== 11 ? forms[0] : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? forms[1] : forms[2];
};
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} page="cases" path={path} crumbs={[{ name: t(lang, 'nav.cases'), route: 'cases/' }]}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: c('hero.title'), inLanguage: lang,
    hasPart: cases.map((x) => ({ '@type': 'CreativeWork', name: pick(lang, x.name), url: `${site}${Astro.url.pathname}${x.id}/` })) }]}>
  <Block theme="dark" label={c('hero.label')} first hero class="page-hero projects-block cases-page">
    <div class="container">
      <p class="label hero__label reveal">{c('hero.label')}</p>
      <h1 class="hero__title reveal" data-split>{c('hero.title')}</h1>
      <p class="lead hero__lead reveal" style="--rd:120ms">{c('hero.lead')}</p>
    </div>

    <nav class="csnav reveal" aria-label={c('hero.title')} data-csnav data-subbar>
      <div class="container">
        <ol class="csnav__list list-reset">
          {sectors.map((s, i) => (
            <li><a class:list={['chip', i === 0 && 'is-on']} href={`#${s.id}`} data-sector={s.id}>
              <span>{pick(lang, s.title)}</span><span class="chip__count num" data-count={casesBySector(s.id).length} data-pad="2">{pad(casesBySector(s.id).length)}</span>
            </a></li>
          ))}
        </ol>
      </div>
    </nav>

    <div class="container">
      {sectors.map((s, i) => {
        const list = casesBySector(s.id);
        return (
          <section class="csec" id={s.id} aria-labelledby={`h-${s.id}`} data-csec={s.id}>
            <p class="label muted csec__label reveal">{pad(i + 1)} · {list.length} {plural(list.length)}</p>
            <h2 class="csec__title reveal" id={`h-${s.id}`} data-split>{pick(lang, s.title)}</h2>
            <p class="muted csec__lead reveal">{pick(lang, s.line)}</p>
            <ul class="pgrid list-reset">
              {list.map((x) => <CaseCard item={x} lang={lang} index={cases.indexOf(x)} />)}
            </ul>
          </section>
        );
      })}
    </div>
  </Block>

  <SiteCta lang={lang} theme="light" />
</Base>

<script>
  // Chips follow the section in view; the active chip is kept visible in the horizontal row.
  const nav = document.querySelector<HTMLElement>('[data-csnav]');
  if (nav) {
    const chips = [...nav.querySelectorAll<HTMLAnchorElement>('.chip')];
    const list = nav.querySelector<HTMLElement>('.csnav__list')!;
    const mark = (id: string) => chips.forEach((c) => {
      const on = c.dataset.sector === id;
      c.classList.toggle('is-on', on);
      if (on) {
        c.setAttribute('aria-current', 'true');
        // keep the whole active chip in view (scroll-padding-inline = page margins)
        if (list.scrollWidth > list.clientWidth) {
          const pad = parseFloat(getComputedStyle(list).paddingLeft) || 16;
          const l = c.offsetLeft - list.offsetLeft, r = l + c.offsetWidth;
          if (l - pad < list.scrollLeft || r + pad > list.scrollLeft + list.clientWidth) list.scrollTo({ left: l - pad, behavior: 'smooth' });
        }
      } else c.removeAttribute('aria-current');
    });
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) mark((e.target as HTMLElement).dataset.csec!);
    }, { rootMargin: '-35% 0px -60% 0px' });
    const secs = [...document.querySelectorAll<HTMLElement>('[data-csec]')];
    secs.forEach((s) => io.observe(s));
    // above the first section the first chip is current (and the row is scrolled back to the start)
    window.addEventListener('scroll', () => { if (secs[0].getBoundingClientRect().top > window.innerHeight * 0.4) mark(secs[0].dataset.csec!); }, { passive: true });
    // old links: /cases/?sector=<id> → the section
    const id = new URL(location.href).searchParams.get('sector');
    const target = id && document.getElementById(id);
    if (target && target.matches('[data-csec]')) requestAnimationFrame(() => { target.scrollIntoView(); mark(id!); });
  }
</script>
