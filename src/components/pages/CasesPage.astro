---
// /cases/ after the rework (docs/14-rework.md §6.3): one-line title → CORE scene → chips → 8 industry sections +
// «Websites we build», each a horizontal ribbon (manual), ordered by rank. /cases/?sector=<id> and #<id> open a section.
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import CoreScene from '../CoreScene.astro';
import CaseFilter from '../CaseFilter.astro';
import CaseRow from '../CaseRow.astro';
import SiteCta from '../SiteCta.astro';
import { t, ta, pick, type Lang } from '../../lib/i18n';
import { cases, sectors, casesBySector, byRank, sites } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const site = Astro.site!.origin;
const title = t(lang, 'casesBlock.title').split(/\s*•\s*/);
const forms = ta<string[]>(lang, 'cases.forms');
const plural = (n: number) => {
  if (lang !== 'ru') return n === 1 ? forms[0] : forms[1];
  const m10 = n % 10, m100 = n % 100;
  return m10 === 1 && m100 !== 11 ? forms[0] : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? forms[1] : forms[2];
};
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} page="cases" path={t(lang, 'home.windows.cases.path')} crumbs={[{ name: t(lang, 'nav.cases'), route: 'cases/' }]}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: t(lang, 'cases.hero.title'), inLanguage: lang,
    hasPart: cases.map((x) => ({ '@type': 'CreativeWork', name: pick(lang, x.name), url: `${site}${Astro.url.pathname}${x.id}/` })) }]}>
  <Block theme="dark" label={title[0]} first hero class="rcases rcases--page">
    <div class="container">
      <h1 class="rcases__title reveal">{title.map((w, i) => <>{i > 0 && <span class="dot" aria-hidden="true"> • </span>}<span class="nowrap">{w}</span></>)}</h1>
      <CoreScene lang={lang} compact />
      <CaseFilter lang={lang} mode="nav" />
      {sectors.map((s, i) => {
        const list = byRank(casesBySector(s.id));
        return (
          <section class="csec2" id={s.id} aria-labelledby={`h-${s.id}`}>
            <p class="label muted">{pad(i + 1)} · {list.length} {plural(list.length)}</p>
            <h2 class="csec2__title" id={`h-${s.id}`}>{pick(lang, s.title)}</h2>
            <p class="muted small csec2__lead">{pick(lang, s.line)}</p>
            <CaseRow lang={lang} items={list} label={pick(lang, s.title)} />
          </section>
        );
      })}
      <section class="csec2" id="sites" aria-labelledby="h-sites">
        <p class="label muted">{pad(sectors.length + 1)} · {sites.length}</p>
        <h2 class="csec2__title" id="h-sites">{t(lang, 'casesBlock.sitesTitle')}</h2>
        <CaseRow lang={lang} items={[]} sites={sites} label={t(lang, 'casesBlock.sitesTitle')} />
      </section>
    </div>
  </Block>

  <SiteCta lang={lang} theme="light" />
</Base>
