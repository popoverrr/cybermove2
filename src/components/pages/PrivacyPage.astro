---
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import { t, ta, type Lang } from '../../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const sections = ta<{ h: string; p: string }[]>(lang, 'privacy.sections');
---
<Base lang={lang} page="privacy" path={`cyber move / ${t(lang, 'footer.privacy').toLowerCase()}`} crumbs={[{ name: t(lang, 'privacy.title'), route: 'privacy/' }]}>
  <Block theme="light" label={t(lang, 'privacy.title')} first hero class="privacy">
    <div class="container">
      <div class="prose">
        <p class="label muted reveal">{t(lang, 'privacy.label')}</p>
        <h1 class="h2 reveal privacy__title" data-split>{t(lang, 'privacy.title')}</h1>
        {sections.map((s, i) => (
          <section class="prose__section reveal">
            <h2 class="h3"><span class="label muted num">{String(i + 1).padStart(2, '0')}</span> {s.h}</h2>
            <p>{s.p}</p>
          </section>
        ))}
      </div>
    </div>
  </Block>
</Base>
