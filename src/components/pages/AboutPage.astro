---
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import BlockHead from '../BlockHead.astro';
import Icon from '../Icon.astro';
import GeoMap from '../GeoMap.astro';
import Formats from '../Formats.astro';
import SiteCta from '../SiteCta.astro';
import { t, ta, href, pick, type Lang } from '../../lib/i18n';
import { directions, regions, cities } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = (k: string) => t(lang, `about.${k}`);
const numbers = ta<{ value: string; label: string }[]>(lang, 'about.numbers.items');
const what = ta<{ label: string; title: string; text: string }[]>(lang, 'about.what.items');
const steps = ta<{ stage: string; title: string; text: string }[]>(lang, 'about.approach.steps');
const why = ta<{ title: string; text: string }[]>(lang, 'about.why.items');
const metrics = ta<{ code: string; name: string; text: string }[]>(lang, 'about.metrics.items');
const also = ta<string[]>(lang, 'about.metrics.also');
const regionTexts = ta<{ name: string; cities: string; text: string | null; cases: { text: string; slug: string }[] }[]>(lang, 'about.geo.regions');
const num = (v: string) => { const m = v.match(/^(\d+)(.*)$/); return m ? { n: m[1], s: m[2] } : { n: v, s: '' }; };
---
<Base lang={lang} page="about" path={t(lang, 'home.windows.about.path')} crumbs={[{ name: t(lang, 'nav.about'), route: 'about/' }]}>
  <Block theme="dark" label={a('hero.codes')} first hero class="page-hero about-hero">
    <div class="container">
      <h1 class="hero__title reveal"><span class="label hero__label hero__kicker">{a('hero.kicker')}</span> <span class="hero__thesis" data-split>{a('hero.title')}</span></h1>
      <div class="about-hero__cols">
        <p class="lead reveal" style="--rd:120ms">{a('hero.text')}</p>
        <p class="label muted reveal about-hero__codes" style="--rd:200ms">{a('hero.codes')}</p>
      </div>
    </div>
  </Block>

  <Block theme="light" label={a('numbers.title')} class="about-numbers">
    <div class="container">
      <BlockHead label={a('numbers.title')} />
      <dl class="stats list-reset">
        {numbers.map((s, i) => { const v = num(s.value); return (
          <div class="stats__item reveal" style={`--rd:${i * 60}ms`}>
            <dt class="stats__num num"><span data-count={v.n}>{v.n}</span>{v.s && <span class="stats__suffix">{v.s}</span>}</dt>
            <dd class="muted">{s.label}</dd>
          </div>
        ); })}
      </dl>
    </div>
  </Block>

  <Block theme="dark" label={a('what.title')} class="about-core">
    <div class="container">
      <BlockHead label={a('what.title')} />
      <h2 class="section-title reveal" data-split>{a('what.title')}</h2>
      <ol class="core__grid core__grid--5 list-reset reveal">
        {what.map((c, i) => (
          <li class="core__cell">
            <a class="core__link" href={href(lang, `services/${directions[i].id}/`)}>
              <span class="label muted">{c.label}</span>
              <h3 class="core__title">{c.title}</h3>
              <p class="small muted">{c.text}</p>
              <Icon name="arrow" size={16} class="core__arrow" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  <Block theme="light" label={a('approach.title')} class="about-ai">
    <div class="container">
      <BlockHead label={a('approach.title')} />
      <h2 class="reveal" data-split>{a('approach.title')}</h2>
      <ol class="chain list-reset reveal section-lead-after" aria-label={steps.map((s) => s.stage).join(' → ')}>
        {steps.map((s, i) => (
          <li class="chain__item" style={`--i:${i}`}>
            <span class="chain__word">{s.stage}</span>
            {i < steps.length - 1 && <span class="chain__arrow" aria-hidden="true"><i></i></span>}
          </li>
        ))}
      </ol>
      <ol class="cols4 list-reset">
        {steps.map((s, i) => (
          <li class="cols3__item reveal" style={`--rd:${i * 80}ms`}>
            <span class="label muted num">{String(i + 1).padStart(2, '0')} · {s.stage}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  <Block theme="dark" label={a('why.title')} class="about-principles">
    <div class="container">
      <BlockHead label={a('why.title')} />
      <h2 class="section-title reveal" data-split>{a('why.title')}</h2>
      <ol class="cols3 list-reset">
        {why.map((p, i) => (
          <li class="cols3__item reveal" style={`--rd:${i * 80}ms`}>
            <span class="label muted num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  <Formats lang={lang} theme="light" />

  <Block theme="dark" label={a('metrics.title')} id="metrics" class="about-metrics">
    <div class="container">
      <BlockHead label={metrics.map((m) => m.code).join(' · ')} />
      <h2 class="reveal" data-split>{a('metrics.title')}</h2>
      <p class="lead muted section-lead-after reveal">{a('metrics.lead')}</p>
      <dl class="mrows">
        {metrics.map((m, i) => (
          <div class="mrows__row reveal" style={`--rd:${i * 40}ms`}>
            <dt><span class="mrows__code">{m.code}</span><span class="mrows__name">{m.name}</span></dt>
            <dd class="muted">{m.text}</dd>
          </div>
        ))}
      </dl>
      <h3 class="label muted metrics__also reveal">{a('metrics.alsoTitle')}</h3>
      <ul class="tags list-reset reveal" role="list">{also.map((x) => <li class="tag">{x}</li>)}</ul>
    </div>
  </Block>

  <Block theme="light" label={a('geo.title')} class="about-geo">
    <div class="container">
      <BlockHead label={`${String(cities.length).padStart(2, '0')} · ${a('geo.title')}`} />
      <h2 class="reveal" data-split>{a('geo.title')}</h2>
      <p class="lead muted section-lead-after reveal">{a('geo.lead')}</p>
      <div class="geo">
        <div class="geo__map reveal"><GeoMap /></div>
        <ol class="geo__cities list-reset reveal">
          {cities.map((c, i) => (
            <li class="geo__city" data-city={c.id} tabindex="0"><span class="label muted">{String(i + 1).padStart(2, '0')}</span><span class="geo__city-name">{c.name}</span></li>
          ))}
        </ol>
      </div>
      <h3 class="label muted geo__regions-title reveal">{a('geo.regionsTitle')}</h3>
      <div class="geo__lists">
        {regions.map((r, i) => { const rt = regionTexts[i]; return (
          <div class="geo__region reveal">
            <h4 class="geo__region-name h3">{pick(lang, r.label)}</h4>
            <p class="label muted">{rt.cities}</p>
            {rt.text && <p class="muted small geo__region-text">{rt.text}</p>}
            {rt.cases.length > 0 && (
              <ul class="list-reset geo__cases">
                {rt.cases.map((c) => <li><a class="link link--arrow" href={href(lang, `cases/${c.slug}/`)}><span>{c.text}</span><Icon name="arrow" size={12} /></a></li>)}
              </ul>
            )}
          </div>
        ); })}
      </div>
    </div>
  </Block>

  <SiteCta lang={lang} />
</Base>

<script>
  // Geography: hovering / focusing a city highlights its dot.
  document.querySelectorAll<HTMLElement>('.geo__city').forEach((el) => {
    const dot = document.querySelector(`.geomap [data-dot="${el.dataset.city}"]`);
    const on = () => dot?.classList.add('is-on');
    const off = () => dot?.classList.remove('is-on');
    el.addEventListener('pointerenter', on); el.addEventListener('pointerleave', off);
    el.addEventListener('focus', on); el.addEventListener('blur', off);
    el.addEventListener('click', () => { document.querySelectorAll('.geomap .is-on').forEach((d) => d.classList.remove('is-on')); on(); });
  });
</script>
