---
// Home after the rework (docs/14-rework.md §0): hero (label, one-line H1, CORE scene, description, one button) →
// cases (filter + endless horizontal ribbon) → brands strip → 10 services → «How we work» → insights → CTA.
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import BlockHead from '../BlockHead.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Marquee from '../Marquee.astro';
import CoreScene from '../CoreScene.astro';
import CaseFilter from '../CaseFilter.astro';
import CaseRow from '../CaseRow.astro';
import ServicesList from '../ServicesList.astro';
import { t, ta, url, href, pick, type Lang } from '../../lib/i18n';
import { casesRanked, sites, insights, directionById } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = (k: string) => t(lang, `home.${k}`);
const dots = (s: string) => s.split(/\s*•\s*/);
const titleParts = h('hero.title').split(/(?<=\.)\s+/); // three phrases
const names = ta<string[]>(lang, 'home.clients.names');
const half = Math.ceil(names.length / 2);
const steps = ta<{ stage: string; title: string; text: string }[]>(lang, 'method.steps');
const svc = ta<{ label: string; to: string }[]>(lang, 'homeServices.items');
const latest = insights.slice(0, 4);
const casesTitle = dots(t(lang, 'casesBlock.title'));
---
<Base lang={lang} page="home" path="cyber move consulting" jsonLd={[]}>
  <!-- 1 · Hero -->
  <Block theme="dark" label="CYBER MOVE CONSULTING" first hero class="rhero">
    <div class="container">
      <p class="rhero__label reveal">{dots(h('hero.label')).map((w, i) => <>{i > 0 && <span class="dot" aria-hidden="true">•</span>}{w}</>)}</p>
      <h1 class="rhero__title reveal">{titleParts.map((p, i) => <><b>{p.replace(/\.$/, '')}</b><span class="dot">.</span>{i < titleParts.length - 1 && ' '}</>)}</h1>
      <CoreScene lang={lang} />
      <p class="rhero__p1 reveal">{h('hero.p1')}</p>
      <p class="rhero__p2 reveal">{h('hero.p2')}</p>
      <div class="rhero__cta reveal"><Button href={url(lang, 'contact', '?service=business-audit')} data-service="business-audit">{h('hero.cta')}</Button></div>
    </div>
  </Block>

  <!-- 2 · Cases -->
  <Block theme="dark" label={casesTitle[0]} class="rcases" id="cases">
    <div class="container">
      <h2 class="rcases__title reveal">{casesTitle.map((w, i) => <>{i > 0 && <span class="dot" aria-hidden="true"> • </span>}<span class="nowrap">{w}</span></>)}</h2>
      <CaseFilter lang={lang} mode="filter" target="home-cases" />
      <CaseRow lang={lang} items={casesRanked()} sites={sites} auto id="home-cases" label={casesTitle[0]} />
      <div class="rcases__all reveal"><Button href={url(lang, 'cases')} variant="secondary">{t(lang, 'casesBlock.seeAll')}</Button></div>
    </div>
  </Block>

  <!-- 3 · Brands strip, right under the cases -->
  <Block theme="dark" label={casesTitle[0]} flow="continue" tight class="rbrands">
    <Marquee rows={[names.slice(0, half), names.slice(half)]} label={h('clients.label')} />
  </Block>

  <!-- 4 · Services: 10 rows -->
  <Block theme="light" label={t(lang, 'homeServices.title')} class="rsvc">
    <div class="container">
      <BlockHead label={`01–${String(svc.length).padStart(2, '0')}`} link={{ href: url(lang, 'services'), text: t(lang, 'nav.services') }} />
      <h2 class="block-title-sm reveal">{t(lang, 'homeServices.title')}</h2>
      <ServicesList lang={lang} />
    </div>
  </Block>

  <!-- 5 · How we work -->
  <Block theme="dark" label={t(lang, 'method.title')} class="home-method rmethod">
    <div class="container">
      <BlockHead label={t(lang, 'method.label')} />
      <div class="method" data-method>
        <div class="method__aside">
          <h2 class="block-title-sm reveal">{t(lang, 'method.title')}</h2>
          <div class="method__counter label" aria-hidden="true">
            <span class="method__now num">01</span><span class="muted"> / {String(steps.length).padStart(2, '0')}</span>
            <span class="method__track"><i class="method__fill"></i></span>
          </div>
        </div>
        <ol class="method__steps list-reset">
          {steps.map((s, i) => (
            <li class:list={['method__step reveal', i === 0 && 'is-active']} data-step={i}>
              <span class="label muted">{String(i + 1).padStart(2, '0')} · {s.stage}</span>
              <h3 class="method__title method__title--sm">{s.title}</h3>
              <p class="method__text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Block>

  <!-- 6 · Insights, compact -->
  <Block theme="light" label={t(lang, 'nav.insights')} class="rins">
    <div class="container">
      <BlockHead label={t(lang, 'nav.insights')} link={{ href: url(lang, 'insights'), text: t(lang, 'insights.allInsights') }} />
      <h2 class="block-title-sm reveal">{t(lang, 'nav.insights')}</h2>
      <ol class="rins__list list-reset">
        {latest.map((a) => (
          <li class="rins__row reveal">
            <a class="rins__link" href={href(lang, `insights/${a.direction}/${a.id}/`)}>
              <span class="label muted">{pick(lang, directionById(a.direction).name)} · {pick(lang, a.read)}</span>
              <span class="rins__title">{pick(lang, a.title)}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="rins__more"><a class="link link--arrow" href={url(lang, 'insights')}><span>{t(lang, 'insights.allInsights')}</span><Icon name="arrow" size={14} /></a></p>
    </div>
  </Block>

  <!-- 7 · CTA (one button, opens the contact panel) -->
  <Block theme="dark" label={h('cta.label')} class="cta">
    <div class="container">
      <h2 class="cta__title reveal">{h('cta.title')}</h2>
      <p class="lead muted cta__lead reveal">{h('cta.lead')}</p>
      <div class="cta__actions reveal"><Button href={url(lang, 'contact')}>{h('cta.primary')}</Button></div>
    </div>
  </Block>
</Base>

<script>
  import '../../scripts/method';
</script>
