---
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import BlockHead from '../BlockHead.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import HomeWindows from '../HomeWindows.astro';
import Marquee from '../Marquee.astro';
import SectorMorph from '../SectorMorph.astro';
import CaseCard from '../CaseCard.astro';
import CoreOrbit from '../CoreOrbit.astro';
import CtaBlock from '../CtaBlock.astro';
import WindowFrame from '../WindowFrame.astro';
import { t, ta, url, href, pick, type Lang } from '../../lib/i18n';
import { directions, servicesOf, caseById, contacts, company } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = (k: string) => t(lang, `home.${k}`);
const names = ta<string[]>(lang, 'home.clients.names');
const half = Math.ceil(names.length / 2);
const steps = ta<{ stage: string; title: string; text: string }[]>(lang, 'method.steps');
const stats = ta<{ value: string; suffix: string; label: string }[]>(lang, 'home.results.stats');
const featured = ta<string[]>(lang, 'home.results.featured').map(caseById);
const approach = ta<{ title: string; text: string }[]>(lang, 'home.approach.items');
const svcPath = t(lang, 'home.windows.services.path');
---
<Base lang={lang} page="home" path="cybermove" jsonLd={[]}>
  <!-- 1 · Hero + CORE schema + windows -->
  <Block theme="dark" label={company.brand} first hero class="home-hero">
    <div class="container">
      <div class="home-hero__fig" aria-hidden="false"><CoreOrbit lang={lang} /></div>
      <p class="label hero__label reveal">{h('hero.label')}</p>
      <h1 class="hero__title home-hero__title reveal" data-split>{h('hero.title')}</h1>
      <div class="home-hero__row">
        <p class="lead hero__lead reveal" style="--rd:120ms">{h('hero.lead')}</p>
        <div class="btn-row btn-row--stack hero__actions reveal" style="--rd:200ms">
          <Button href={url(lang, 'contact', '?service=business-audit')}>{h('hero.ctaPrimary')}</Button>
          <Button href={url(lang, 'cases')} variant="secondary">{h('hero.ctaSecondary')}</Button>
        </div>
      </div>
      <HomeWindows lang={lang} />
    </div>
  </Block>

  <!-- 2 · Clients marquee (continues the hero) -->
  <Block theme="dark" label={h('clients.label')} flow="continue" class="home-clients">
    <div class="container">
      <BlockHead label={`02 · ${h('clients.label')}`} link={{ href: url(lang, 'cases'), text: h('results.link') }} />
    </div>
    <Marquee rows={[names.slice(0, half), names.slice(half)]} label={h('clients.label')} />
  </Block>

  <!-- 3 · Service areas index -->
  <Block theme="light" label={h('directions.label')} class="home-services">
    <div class="container">
      <BlockHead label={h('directions.label')} link={{ href: url(lang, 'services'), text: t(lang, 'nav.services') }} />
      <h2 class="section-title reveal" data-split>{h('directions.title')}</h2>
      <ol class="svc list-reset">
        {directions.map((d, i) => (
          <li class="svc__row reveal" style={`--rd:${i * 40}ms`}>
            <a class="svc__link" href={href(lang, `services/${d.id}/`)}>
              <span class="svc__idx label muted">{d.index}</span>
              <span class="svc__main">
                <span class="svc__title h3">{pick(lang, d.thesis)}</span>
                <span class="svc__lead muted"><span class="label svc__name">{d.index} — {pick(lang, d.name)} · {d.codes}</span><br />{pick(lang, d.lead)}</span>
              </span>
              <Icon name="arrow" size={20} class="svc__arrow" />
            </a>
            <WindowFrame path={`${svcPath} / ${d.id}`} class="svc__preview" aria-hidden="true">
              <ul class="list-reset label">{servicesOf(d).map((s) => <li>{pick(lang, s.name)}</li>)}</ul>
            </WindowFrame>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  <!-- 4 · Method -->
  <Block theme="dark" label={t(lang, 'method.label')} class="home-method">
    <div class="container">
      <BlockHead label={t(lang, 'method.label')} />
      <div class="method" data-method>
        <div class="method__aside">
          <h2 class="reveal" data-split>{t(lang, 'method.title')}</h2>
          <div class="method__counter label" aria-hidden="true">
            <span class="method__now num">01</span><span class="muted"> / {String(steps.length).padStart(2, '0')}</span>
            <span class="method__track"><i class="method__fill"></i></span>
          </div>
        </div>
        <ol class="method__steps list-reset">
          {steps.map((s, i) => (
            <li class:list={['method__step reveal', i === 0 && 'is-active']} data-step={i}>
              <span class="label muted">{String(i + 1).padStart(2, '0')} · {s.stage}</span>
              <h3 class="method__title">{s.title}</h3>
              <p class="lead method__text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Block>

  <!-- 5 · Sectors (interaction #3) -->
  <Block theme="light" label={t(lang, 'cases.hero.label')} class="home-sectors">
    <div class="container">
      <BlockHead label={t(lang, 'cases.hero.label')} />
      <h2 class="reveal" data-split>{t(lang, 'cases.hero.title')}</h2>
      <p class="lead muted section-lead-after reveal">{t(lang, 'cases.hero.lead')}</p>
      <div class="reveal"><SectorMorph lang={lang} label={t(lang, 'cases.hero.title')} allLabel={h('results.link')} /></div>
    </div>
  </Block>

  <!-- 6 · Results: numbers + featured cases -->
  <Block theme="dark" label={h('results.label')} class="home-results">
    <div class="container">
      <BlockHead label={h('results.label')} link={{ href: url(lang, 'cases'), text: h('results.link') }} />
      <h2 class="section-title reveal" data-split>{h('results.title')}</h2>
      <dl class="stats list-reset">
        {stats.map((s, i) => (
          <div class="stats__item reveal" style={`--rd:${i * 60}ms`}>
            <dt class="stats__num num"><span data-count={s.value}>{s.value}</span>{s.suffix && <span class="stats__suffix">{s.suffix}</span>}</dt>
            <dd class="muted">{s.label}</dd>
          </div>
        ))}
      </dl>
      <ul class="pgrid pgrid--home list-reset">
        {featured.map((c, i) => <CaseCard item={c} lang={lang} index={i + 1} ratio="4x5" />)}
      </ul>
      <div class="reveal results__all"><Button href={url(lang, 'cases')} variant="secondary">{h('results.link')}</Button></div>
    </div>
  </Block>

  <!-- 7 · Approach (principles) -->
  <Block theme="light" label={h('approach.label')} class="home-approach">
    <div class="container">
      <BlockHead label={h('approach.label')} link={{ href: url(lang, 'about'), text: h('approach.link') }} />
      <h2 class="section-title reveal" data-split>{h('approach.title')}</h2>
      <ol class="cols3 list-reset">
        {approach.map((p, i) => (
          <li class="cols3__item reveal" style={`--rd:${i * 80}ms`}>
            <span class="label muted num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </Block>

  <!-- 8 · Final CTA -->
  <CtaBlock
    theme="dark"
    label={h('cta.label')}
    title={h('cta.title')}
    lead={h('cta.lead')}
    primary={{ href: url(lang, 'contact'), text: h('cta.primary') }}
    secondary={{ href: contacts.whatsapp.url, text: h('cta.secondary'), icon: 'whatsapp', external: true }}
  />
</Base>

<script>
  import '../../scripts/method';
</script>
