---
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import BlockHead from '../BlockHead.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import SiteCta from '../SiteCta.astro';
import Formats from '../Formats.astro';
import { t, href, pick, type Lang } from '../../lib/i18n';
import { directions, directionById, servicesOf } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = (k: string) => t(lang, `services.${k}`);
const audit = directionById('audit');
const rest = directions.filter((x) => x.id !== 'audit');
const path = t(lang, 'home.windows.services.path');
---
<Base lang={lang} page="services" path={path} crumbs={[{ name: t(lang, 'nav.services'), route: 'services/' }]}>
  <Block theme="dark" label={s('hero.label')} first hero class="page-hero">
    <div class="container">
      <p class="label hero__label reveal">{s('hero.label')}</p>
      <h1 class="hero__title reveal" data-split>{s('hero.title')}</h1>
      <p class="lead hero__lead reveal" style="--rd:120ms">{s('hero.lead')}</p>
      <p class="label muted hero__codes reveal" style="--rd:180ms">{s('hero.codes')}</p>
    </div>
  </Block>

  <!-- Audit: the entry point -->
  <Block theme="light" label={`${audit.index} · ${audit.stage}`} id="audit" class="svc-audit">
    <div class="container">
      <BlockHead label={`${audit.index} · ${audit.stage}`} />
      <div class="split">
        <div class="split__a">
          <h2 class="reveal" data-split>{pick(lang, audit.name)}</h2>
          <p class="lead muted split__lead reveal">{pick(lang, audit.lead)}</p>
          <p class="label muted split__sub reveal">{s('resultLabel')}</p>
          <p class="reveal split__result">{pick(lang, audit.result)}</p>
          <div class="reveal split__cta"><Button href={href(lang, `services/${audit.id}/`)}>{s('directionLink')}</Button></div>
        </div>
        <div class="split__b">
          <ol class="numrows list-reset">
            {servicesOf(audit).map((x, i) => (
              <li class="numrows__row reveal" style={`--rd:${i * 60}ms`}>
                <span class="label muted num">{x.index}</span>
                <a class="numrows__link" href={href(lang, `services/${audit.id}/${x.id}/`)}>
                  <span class="numrows__text">{pick(lang, x.name)}</span>
                  <span class="numrows__sub muted small">{pick(lang, x.line)}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </Block>

  <!-- Other four areas (accordion) -->
  <Block theme="dark" label={s('hero.codes')} class="svc-directions">
    <div class="container">
      <BlockHead label={s('hero.codes')} />
      <div class="acc dirs" data-accordion>
        {rest.map((d) => (
          <details class="acc__item dirs__item" id={d.id}>
            <summary class="acc__head">
              <span class="acc__idx label">{d.index}</span>
              <span class="dirs__head">
                <span class="acc__title h3">{pick(lang, d.name)}</span>
                <span class="dirs__lead muted">{pick(lang, d.lead)}</span>
              </span>
              <span class="acc__plus" aria-hidden="true"></span>
            </summary>
            <div class="acc__body"><div><div class="acc__content">
              <div class="dirs__grid">
                <ol class="dirs__svc list-reset">
                  {servicesOf(d).map((x) => (
                    <li><a class="dirs__svc-link" href={href(lang, `services/${d.id}/${x.id}/`)}>
                      <span class="label muted">{x.index}</span>
                      <span><span class="dirs__svc-name">{pick(lang, x.name)}</span><span class="small muted">{pick(lang, x.line)}</span></span>
                      <Icon name="arrow" size={14} />
                    </a></li>
                  ))}
                </ol>
                <div>
                  <h3 class="label muted dirs__sub">{s('resultLabel')}</h3>
                  <p class="lead">{pick(lang, d.result)}</p>
                  <a class="link link--arrow dirs__discuss" href={href(lang, `services/${d.id}/`)}><span>{s('directionLink')}</span><Icon name="arrow" size={14} /></a>
                </div>
              </div>
            </div></div></div>
          </details>
        ))}
      </div>
      <p class="reveal svc-about"><a class="link link--arrow" href={href(lang, 'about/')}><span>{s('aboutLink')}</span><Icon name="arrow" size={14} /></a></p>
    </div>
  </Block>

  <Formats lang={lang} theme="light" />

  <SiteCta lang={lang} />
</Base>
