---
import Base from '../../layouts/Base.astro';
import Block from '../Block.astro';
import Icon from '../Icon.astro';
import Marquee from '../Marquee.astro';
import ContactForm from '../ContactForm.astro';
import { t, type Lang } from '../../lib/i18n';
import { contacts, cities } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = (k: string) => t(lang, `contact.${k}`);
---
<Base lang={lang} page="contact" path={t(lang, 'home.windows.contact.path')} crumbs={[{ name: t(lang, 'nav.contact'), route: 'contact/' }]}>
  <Block theme="light" label={t(lang, 'nav.contact')} first hero class="contact-hero">
    <div class="container">
      <p class="label hero__label reveal">{t(lang, 'common.codes')}</p>
      <h1 class="hero__title reveal" data-split>{c('hero.title')}</h1>
      <p class="lead hero__lead reveal" style="--rd:120ms">{c('hero.lead')}</p>

      <div class="contact">
        <div class="contact__channels reveal">
          <h2 class="label muted">{c('channels.whatsapp')}</h2>
          <a class="contact__wa" href={contacts.whatsapp.url} target="_blank" rel="noopener" data-magnetic>
            <span class="contact__wa-icon"><Icon name="whatsapp" size={22} /></span>
            <span class="contact__wa-num">{contacts.whatsapp.display}</span>
            <Icon name="arrow-ne" size={20} class="contact__wa-arrow" />
          </a>
          <dl class="contact__list">
            {contacts.phone && <div><dt class="label muted">{c('channels.phoneLabel')}</dt><dd><a class="link" href={`tel:${contacts.phone.number}`}>{contacts.phone.display}</a></dd></div>}
            <div><dt class="label muted">{c('channels.companyLabel')}</dt><dd>{c('channels.company')}</dd></div>
            {contacts.email && <div><dt class="label muted">E-mail</dt><dd><a class="link" href={`mailto:${contacts.email}`}>{contacts.email}</a></dd></div>}
          </dl>
        </div>
        <div class="contact__form reveal" style="--rd:120ms">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </Block>

  <Block theme="dark" label={c('geo.label')} tight class="contact-geo">
    <div class="container"><p class="label muted contact-geo__label">{c('geo.label')}</p></div>
    <Marquee rows={[cities.map((x) => x.name)]} label={c('geo.label')} />
  </Block>
</Base>
