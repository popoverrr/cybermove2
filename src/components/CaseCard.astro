---
import CasePhoto from './CasePhoto.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href, pick, type Lang } from '../lib/i18n';
import { sectors, monogram, type Case } from '../lib/content';
interface Props { item: Case; lang: Lang; headingLevel?: 'h2' | 'h3'; index?: number; as?: 'li' | 'div'; ratio?: '4x3' | '4x5'; dup?: boolean }
const { item: c, lang, headingLevel: H = 'h3', index = 99, as: Tag = 'li', ratio = '4x3', dup = false } = Astro.props;
const sector = sectors.find((s) => s.id === c.sector);
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/live/*.webp', { eager: true });
const logo = c.logo ? logos[`/src/assets/live/${c.logo}`]?.default : undefined;
---
<Tag class:list={['pcard', ratio === '4x5' && 'pcard--tall']} data-sector={c.sector} data-id={c.id} aria-hidden={dup ? 'true' : undefined}>
  <a class="pcard__link" href={href(lang, `cases/${c.id}/`)} data-cursor tabindex={dup ? -1 : undefined}>
    <div class="pcard__cover">
      <CasePhoto item={c} lang={lang} ratio={ratio} vt={!dup} sizes="(min-width: 1024px) 440px, (min-width: 600px) 48vw, 100vw" eager={index === 0} priority={index === 0} />
      <span class="pcard__chip" aria-hidden="true">
        {logo
          ? <Image src={logo} alt="" height={16} width={Math.round(16 * logo.width / logo.height)} densities={[2]} class="pcard__logo" />
          : <span class="pcard__mono">{monogram(pick(lang, c.cardName))}</span>}
        <span class="pcard__sector label">{c.n} · {sector ? pick(lang, sector.title) : ''}</span>
      </span>
    </div>
    <div class="pcard__body">
      <H class="pcard__name h3">{pick(lang, c.cardName)}</H>
      <p class="pcard__short muted small">{pick(lang, c.tags)}</p>
    </div>
  </a>
</Tag>
