---
// Floating WhatsApp button (docs/10-fixes.md §5): the skeleton's primary button, line icon, fixed bottom-right.
// Without JS it is always visible; with JS it appears after the first screen and hides over the footer / contact form.
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';
import { contacts } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<a class="btn btn--primary wa-fab" href={contacts.whatsapp.url} target="_blank" rel="noopener" aria-label={t(lang, 'common.waAria')} data-wa-fab>
  <span class="btn__in"><Icon name="whatsapp-line" size={20} class="wa-fab__icon" /><span class="wa-fab__text">WhatsApp</span></span>
</a>
<script>
  const fab = document.querySelector<HTMLElement>('[data-wa-fab]');
  if (fab) {
    fab.classList.add('is-armed');
    const blockers = [...document.querySelectorAll('.ftr, [data-contact-form]')];
    const hidden = new Set<Element>();
    let past = false;
    const update = () => fab.classList.toggle('is-on', past && hidden.size === 0);
    const onScroll = () => { const p = window.scrollY > window.innerHeight * 0.85; if (p !== past) { past = p; update(); } };
    const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? hidden.add(e.target) : hidden.delete(e.target))); update(); });
    blockers.forEach((b) => io.observe(b));
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
