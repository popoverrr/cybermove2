---
import { getCollection } from 'astro:content';
import Page from '../../../components/pages/ArticlePage.astro';
export async function getStaticPaths() {
  const all = await getCollection('insights', (e) => e.id.startsWith('ru/'));
  return all.map((entry) => ({ params: { direction: entry.data.direction, slug: entry.id.split('/').pop() }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Page lang="ru" entry={entry} />
