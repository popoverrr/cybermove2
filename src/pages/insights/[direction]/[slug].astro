---
import Page from '../../../components/pages/ArticlePage.astro';
import { articles } from '../../../lib/articles';
export async function getStaticPaths() {
  return (await articles('ru')).map((a) => ({ params: { direction: a.direction, slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
---
<Page lang="ru" article={article} />
