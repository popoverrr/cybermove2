---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/sections.css';
import '../styles/rework.css';
import '../styles/transitions.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { t, href, asset, langs, defaultLang, ogLocale, otherLang, pageSlugs, type Lang, type PageKey } from '../lib/i18n';
import { company, contacts, directions } from '../lib/content';
import seoCodes from '../../content/data/seo.json';
import { pick } from '../lib/i18n';
const contentDate: string = import.meta.env.CONTENT_DATE ?? new Date().toISOString().slice(0, 10);
import fontCyr from '../../node_modules/@fontsource-variable/inter-tight/files/inter-tight-cyrillic-wght-normal.woff2?url';
import fontLat from '../../node_modules/@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import textCyr from '../../node_modules/@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';
import textLat from '../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

export interface Crumb { name: string; route: string }
interface Props {
  lang: Lang;
  /** top-level section (highlights the nav item); 'notFound' for 404 */
  page: PageKey | 'notFound';
  /** route without the language prefix, e.g. 'services/audit/'; defaults to the section's own route */
  route?: string;
  /** mono path shown in the window bar during page transitions */
  path: string;
  /** <title> / description; default: meta.<page> from i18n */
  title?: string;
  description?: string;
  /** breadcrumbs (Home is added automatically) → BreadcrumbList JSON-LD */
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** absolute or root-relative OG image (1200×630); default /og.png */
  ogImage?: string;
  /** article pages: og:type=article + article:* meta */
  article?: { published: string; modified: string; section: string; tags: string[] };
  /** languages this page exists in (default: all) — hreflang only for these */
  langsAvailable?: Lang[];
  /** content date for the sitemap (YYYY-MM-DD) */
  lastmod?: string;
  /** extra <head> links (RSS) */
  rss?: boolean;
}
const { lang, page, path, jsonLd = [], noindex = false, crumbs, article, rss = false } = Astro.props;
const langsAvail = Astro.props.langsAvailable ?? langs;
// Origin only: page URLs from href()/asset() already carry the base path.
const site = Astro.site!.origin;
const isNotFound = page === 'notFound';
const route = Astro.props.route ?? (isNotFound ? '' : pageSlugs[page as PageKey]);
const hrefFor = (l: Lang) => href(l, route);
const canonical = site + (isNotFound ? asset('404.html') : hrefFor(lang));
// a page without a version in the other language switches to that language's section index
const altHref = langsAvail.includes(otherLang(lang)) ? hrefFor(otherLang(lang)) : href(otherLang(lang), route.split('/')[0] ? route.split('/')[0] + '/' : '');
const title = Astro.props.title ?? t(lang, `meta.${page}.title`);
const description = Astro.props.description ?? t(lang, `meta.${page}.description`);
const ogImage = Astro.props.ogImage ? (Astro.props.ogImage.startsWith('http') ? Astro.props.ogImage : site + Astro.props.ogImage) : site + asset('og.png');
const lastmod = Astro.props.lastmod ?? contentDate;

// only real profiles: company.json → sameAs (empty until the owner gives them)
const sameAs = ((company as unknown as { sameAs?: string[] }).sameAs ?? []).filter((v) => /^https?:/.test(v));
const address = (company as unknown as { address?: Record<string, string> | null }).address;
const orgId = site + href(defaultLang) + '#organization';
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': orgId,
  name: company.brand,
  legalName: company.legalName,
  url: site + href(lang),
  logo: site + asset('logo.svg'),
  image: ogImage,
  slogan: company.tagline[lang],
  telephone: contacts.phone?.number ?? `+${contacts.whatsapp.number}`,
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: contacts.phone?.number ?? `+${contacts.whatsapp.number}`,
    contactType: 'sales',
    availableLanguage: ['ru', 'en'],
    url: contacts.whatsapp.url,
  }],
  areaServed: [
    { '@type': 'Country', name: lang === 'ru' ? 'Казахстан' : 'Kazakhstan' },
    ...(lang === 'ru' ? ['Алматы', 'Астана', 'Шымкент'] : ['Almaty', 'Astana', 'Shymkent']).map((name) => ({ '@type': 'City', name })),
  ],
  knowsAbout: directions.map((d) => pick(lang, d.nameFull)),
  ...(sameAs.length ? { sameAs } : {}),
  ...(address ? { address: { '@type': 'PostalAddress', ...address } } : {}),
  ...(contacts.email ? { email: contacts.email } : {}),
};
const website = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': site + href(defaultLang) + '#website',
  name: company.brand, url: site + href(lang), inLanguage: lang, publisher: { '@id': orgId },
};
const breadcrumbs = crumbs && crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ name: t(lang, 'nav.home'), route: '' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: site + href(lang, c.route),
  })),
} : null;
const ld = [org, website, ...(breadcrumbs ? [breadcrumbs] : []), ...jsonLd];
---
<!doctype html>
<html lang={lang} dir="ltr" data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {(noindex || import.meta.env.PUBLIC_PREVIEW) && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  {!isNotFound && langsAvail.map((l) => <link rel="alternate" hreflang={l} href={site + hrefFor(l)} />)}
  {!isNotFound && <link rel="alternate" hreflang="x-default" href={site + hrefFor(langsAvail.includes(defaultLang) ? defaultLang : langsAvail[0])} />}
  {!isNotFound && <meta name="cm:lastmod" content={lastmod} />}
  {seoCodes.googleSiteVerification && <meta name="google-site-verification" content={seoCodes.googleSiteVerification} />}
  {seoCodes.yandexVerification && <meta name="yandex-verification" content={seoCodes.yandexVerification} />}
  {seoCodes.bingVerification && <meta name="msvalidate.01" content={seoCodes.bingVerification} />}
  {rss && <link rel="alternate" type="application/rss+xml" title="Cyber Move Consulting — Разборы" href={site + asset('insights/rss.xml')} />}
  <meta name="theme-color" content="#08090B" />
  <meta name="color-scheme" content="dark light" />
  <meta name="view-transition" content="same-origin" />

  {lang === 'ru' && <link rel="preload" href={fontCyr} as="font" type="font/woff2" crossorigin fetchpriority="high" />}
  <link rel="preload" href={fontLat} as="font" type="font/woff2" crossorigin fetchpriority="high" />
  {lang === 'ru' && <link rel="preload" href={textCyr} as="font" type="font/woff2" crossorigin />}
  <link rel="preload" href={textLat} as="font" type="font/woff2" crossorigin />

  <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
  <link rel="manifest" href={asset('site.webmanifest')} />

  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published} />}
  {article && <meta property="article:modified_time" content={article.modified} />}
  {article && <meta property="article:section" content={article.section} />}
  {article?.tags.map((tg) => <meta property="article:tag" content={tg} />)}
  <meta property="og:site_name" content={company.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale[lang]} />
  {langsAvail.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script is:inline>
    /* Boot: js flag, view-transition support, and the incoming side of the window transition
       (pagereveal must be registered before first render, so it lives here, not in a module). */
    (function (d, w) {
      var h = d.documentElement, ss;
      h.classList.add('js');
      try { ss = w.sessionStorage; } catch (e) {}
      if (!('onpagereveal' in w && w.CSS && CSS.supports('view-transition-name: a'))) { h.classList.add('no-vt'); return; }
      w.addEventListener('pagereveal', function (e) {
        var dir = ss && ss.getItem('cm-dir'), win = ss && ss.getItem('cm-win');
        if (ss) { ss.removeItem('cm-dir'); ss.removeItem('cm-win'); }
        var vt = e.viewTransition;
        if (!vt) return;
        vt.types.add(dir === 'back' ? 'back' : 'forward');
        if (win) {
          try {
            var r = JSON.parse(win);
            ['t', 'r', 'b', 'l'].forEach(function (k) { h.style.setProperty('--w' + k, r[k] + 'px'); });
            vt.types.add('win');
          } catch (err) {}
        }
        if (!w.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          h.classList.add('vt-arrive');
          setTimeout(function () { h.classList.remove('vt-arrive'); }, 1100);
        }
      });
    })(document, window);
  </script>
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  <slot name="head" />

  <!--
    Analytics slot (none by default). If Yandex Metrica / Google Analytics is added here,
    a cookie-consent banner becomes legally required, and the CSP in public/.htaccess must allow its domains.
  -->
</head>
<body>
  <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
  <span id="top"></span>
  <Header lang={lang} page={page} altHref={altHref} />
  <main id="main" data-path={path} tabindex="-1">
    <div class="page-bar" aria-hidden="true"><span class="win__dots"><i></i><i></i><i></i></span><span class="label">{path}</span></div>
    <slot />
  </main>
  <Footer lang={lang} altHref={altHref} />
  <ContactPanel lang={lang} />
  <div class="cursor-label label" aria-hidden="true"><span>{t(lang, 'common.open')} →</span></div>
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
